        },
        "/venues": {
            "get": {
                "tags": [
                    "Площадки"
                ],
                "summary": "Список площадок",
                "operationId": "b3d0a1c57452d0d30bba9b40560f2d18",
                "responses": {
                    "200": {
                        "description": "Список площадок с пагинацией"
                    }
                }
            },
            "post": {
                "tags": [
                    "Площадки"
                ],
                "summary": "Создать площадку (только админ)",
                "operationId": "0bbda601ee6beea68a0b232049f2d9e2",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "address",
                                    "capacity"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Новая студия"
                                    },
                                    "address": {
                                        "type": "string",
                                        "example": "ул. Пушкина, д. 10"
                                    },
                                    "capacity": {
                                        "type": "integer",
                                        "example": 50
                                    },
                                    "hourly_fee": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 150
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Площадка создана"
                    },
                    "403": {
                        "description": "Нет прав"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/venues/{id}": {
            "get": {
                "tags": [
                    "Площадки"
