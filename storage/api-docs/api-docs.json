        "/workshops": {
            "get": {
                "tags": [
                    "Мастер-классы"
                ],
                "summary": "Список мастер-классов с фильтрами",
                "operationId": "c40ca0df753176004d52fc9f4c1fad87",
                "parameters": [
                    {
                        "name": "organizer_id",
                        "in": "query",
                        "description": "Фильтр по организатору",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "date_from",
                        "in": "query",
                        "description": "С даты",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "has_available_spots",
                        "in": "query",
                        "description": "Только с местами",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Сортировка (-starts_at, price, title)",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список с пагинацией"
                    }
                }
            },
            "post": {
                "tags": [
                    "Мастер-классы"
                ],
                "summary": "Создать мастер-класс (организатор/админ)",
                "operationId": "fc091eada51a654b90f223e0b1cb8cb0",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "venue_id",
                                    "title",
                                    "starts_at",
                                    "ends_at",
                                    "max_participants"
                                ],
                                "properties": {
                                    "venue_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "title": {
                                        "type": "string",
                                        "example": "Мастер-класс по рисованию"
                                    },
                                    "starts_at": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2026-12-25 10:00:00"
                                    },
                                    "ends_at": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2026-12-25 13:00:00"
                                    },
                                    "max_participants": {
                                        "type": "integer",
                                        "example": 20
                                    },
                                    "price": {
                                        "type": "number",
                                        "example": 1500
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Создано"
                    },
                    "403": {
                        "description": "Нет прав"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
